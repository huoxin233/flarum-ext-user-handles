{
    "name": "huoxin/user-handles",
    "description": "Display @username handles alongside nicknames across the forum.",
    "keywords": [
        "flarum",
        "extension",
        "name",
        "nickname",
        "handles",
        "username",
        "identity"
    ],
    "support": {
        "issues": "https://github.com/huoxin233/flarum-ext-user-handles/issues",
        "source": "https://github.com/huoxin233/flarum-ext-user-handles",
        "forum": "https://discuss.flarum.org/d/PUT_DISCUSS_SLUG_HERE"
    },
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^1.2.0"
    },
    "authors": [
        {
            "name": "huoxin",
            "email": "23447157+huoxin233@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/huoxin"
        },
        {
            "type": "ko-fi",
            "url": "https://ko-fi.com/huoxin"
        }
    ],
    "autoload": {
        "psr-4": {
            "Huoxin\\UserHandles\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "User Handles",
            "category": "feature",
            "icon": {
                "name": "fas fa-at",
                "color": "#fff",
                "backgroundColor": "#9A2424"
            },
            "optional-dependencies": [
                "flarum/nicknames"
            ]
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": true,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Huoxin\\UserHandles\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "require-dev": {
        "flarum/testing": "^1.0.0"
    }
}
